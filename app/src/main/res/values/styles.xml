<resources>

    <style name="CustomSearchView" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@drawable/searchview_background</item>
        <item name="android:background">@drawable/searchview_background</item>
        <item name="android:textColorHint">#A0A0A0</item>
        <item name="android:textColor">#333333</item>
    </style>

    <style name="CustomTextField" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@drawable/searchview_background</item>
        <item name="android:background">@drawable/searchview_background</item>
        <item name="android:textColorHint">#A0A0A0</item>
        <item name="android:textColor">#333333</item>
    </style>

    <style name="PreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="android:divider">@color/border_color</item>
        <item name="android:dividerHeight">2dp</item>
    </style>

    <style name="CustomSwitchPreferenceCompat" parent="PreferenceThemeOverlay">
        <item name="colorControlActivated">@color/toggle_color</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:background">@drawable/searchview_background</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:searchViewStyle">@drawable/searchview_background</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:editTextColor">@android:color/black</item>

    </style>



</resources>
