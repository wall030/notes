<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:key="dark_mode"
        android:title="Dark Mode"
        android:defaultValue="false"
        app:allowDividerAbove="true"
        app:allowDividerBelow="true"/>

    <Preference
        android:key="sort_by"
        android:title="Sort Notes By"
        android:defaultValue="Timestamp"
        android:summary="Timestamp, Title, or Category"
        android:dialogTheme="@style/CustomDialogTheme"
        app:allowDividerAbove="true"
        app:allowDividerBelow="true"/>

    <Preference
        android:key="manage_categories"
        android:title="Manage Categories"
        app:allowDividerAbove="true"
        app:allowDividerBelow="true"/>

</PreferenceScreen>